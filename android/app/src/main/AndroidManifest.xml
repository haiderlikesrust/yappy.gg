<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!--
      Stripped at merge time: the LiveKit SDK's own manifest carries this for
      its screen-share support, which yappy does not use. A permission in the
      shipped artifact is a capability the app is claiming — Play makes you
      account for every one — and the honest account of a feature we do not
      have is to not carry its permission at all.
    -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"
        tools:node="remove" />

    <!--
      A ring has to become a whole screen on a locked device, not a banner
      behind the lock. Granted at install to apps whose declared purpose is
      calling; if it is ever withheld, CallCoordinator's notification degrades
      to a heads-up banner that still rings and still carries both buttons.
    -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Biometric app lock. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!--
      Tells the chat when somebody screenshots it. Android 14 and up only; a
      normal permission, granted at install, no prompt, and it sees nothing but
      captures of our own window. The pre-14 substitute was watching the photo
      library for screenshot-shaped images, which needed READ_MEDIA_IMAGES —
      Google Play restricts that permission to apps whose core purpose is
      photos, and they are right: the entire photo library was always too much
      to ask for a courtesy line. Devices below 14 simply do not report.
    -->
    <uses-permission android:name="android.permission.DETECT_SCREEN_CAPTURE" />
    <!--
      Sharing a place, and keeping it current while a live share runs. Asked for
      at the moment somebody taps "Location" and never before — a messenger that
      asks where you are on first launch has not earned the question.

      Coarse is listed alongside fine because Android 12 and up lets a person
      grant only the approximate one, and "somewhere in this neighbourhood" is a
      perfectly good answer to "where shall we meet".

      No background permission. A share stops when the app does, which is a
      smaller promise than WhatsApp makes and one this can actually keep.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

    <application
        android:name=".YappyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Yappy"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Yappy.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Invite links: https://yappy.gg/join/<code>, and the same on the
              backup domain.

              Scoped to /join/ on purpose. An unscoped host filter claims every
              URL on the site, so the app would open its own Terms, Privacy and
              developer-portal links instead of letting a browser have them.
              This matches the /join/* scope in
              web/.well-known/apple-app-site-association.

              autoVerify additionally needs /.well-known/assetlinks.json on each
              host, carrying the SHA-256 fingerprint of the signing key. Until
              that is published the link opens a chooser rather than the app,
              and the "Open in the yappy app" button on the /join/ page is the
              fallback.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="yappy.gg" android:pathPrefix="/join/" />
                <data android:scheme="https" android:host="www.yappy.gg" android:pathPrefix="/join/" />
                <data android:scheme="https" android:host="tenku.xyz" android:pathPrefix="/join/" />
                <data android:scheme="https" android:host="www.tenku.xyz" android:pathPrefix="/join/" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="yappy" />
            </intent-filter>

            <!--
              Direct share. The OS delivers ACTION_SEND here when someone picks
              a yappy conversation in the system share sheet; EXTRA_SHORTCUT_ID
              names which one. The category in res/xml/shortcuts.xml is what
              puts the conversations there in the first place.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
          One conversation, floating. The three attributes are the bubble
          contract: embeddable, resizeable, and a fresh document per
          conversation so two bubbles are two windows.
        -->
        <activity
            android:name=".BubbleActivity"
            android:exported="false"
            android:allowEmbedded="true"
            android:resizeableActivity="true"
            android:documentLaunchMode="always"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Yappy" />

        <!--
          Inbound push. Everything arrives data-only now: message pushes are
          rendered by MessageNotifications (MessagingStyle, inline reply), and
          call pushes are turned into a ring by CallCoordinator.
        -->
        <service
            android:name=".data.YappyPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!--
          Keeps the process alive for the length of a call. Without it Android
          freezes the process once it is cached and cuts the microphone
          mid-sentence the moment someone switches apps.
        -->
        <service
            android:name=".data.CallForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Answer and Decline straight from the ring, without unlocking. -->
        <receiver
            android:name=".data.CallActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="gg.yappy.app.CALL_ANSWER" />
                <action android:name="gg.yappy.app.CALL_DECLINE" />
            </intent-filter>
        </receiver>

        <!-- Reply and mark-as-read from the notification, app closed. -->
        <receiver
            android:name=".notifications.NotificationActionReceiver"
            android:exported="false" />

        <!-- The who's-here widget: places with their live presence counts. -->
        <receiver
            android:name=".widget.HereWidgetReceiver"
            android:exported="true"
            android:label="Who's here">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/here_widget_info" />
        </receiver>
    </application>
</manifest>
