<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The XML theme only covers the window before Compose takes over. Making the
      splash background match the neumorphic surface colour is what stops the
      white flash on cold start that otherwise undermines the whole soft look.
    -->
    <style name="Theme.Yappy" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/neu_surface_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!--
      The launch moment. One colour regardless of day/night on purpose: the
      splash is the brand saying hello, and the brand is violet-charcoal with
      the yellow mark on it — the same pairing as the app icon, the landing
      page and the widget. The default (launcher icon on whatever grey the
      system had) read as no decision having been made, because none had.

      The icon itself is deliberately left unset: the SplashScreen API then
      uses the adaptive launcher icon, which is already the mark on its yellow
      plate, correctly masked. Overriding it is how apps end up with the
      double-masked shrunken-icon look.
    -->
    <style name="Theme.Yappy.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="postSplashScreenTheme">@style/Theme.Yappy</item>
    </style>
</resources>
