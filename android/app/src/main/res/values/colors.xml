<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Kept in sync with ui/theme/Color.kt — LightNeuColors.surface and
      DarkNeuColors.surface. Only the pre-Compose window reads these, which is
      exactly one frame: the one where a mismatch shows as a blue-grey flash
      before the violet sheet arrives.
    -->
    <color name="neu_surface_light">#EBE9F4</color>
    <color name="neu_surface_dark">#232030</color>
    <!-- The splash: brand violet-charcoal, same family as the landing page. -->
    <color name="splash_background">#17151F</color>

    <!--
      The launcher icon is yellow while the app's interior is violet, and that
      is deliberate: a home screen is a field of competing icons, and the one
      thing violet cannot do there is stand out. Sampled from the supplied
      artwork rather than guessed.
    -->
    <color name="brand_yellow">#FCCE09</color>
    <color name="ic_launcher_background">@color/brand_yellow</color>
</resources>
