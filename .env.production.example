# yappy.gg — production environment.
#
#   cp .env.production.example .env.production
#
# Then fill in every value marked CHANGE ME. The compose file uses `:?` on the
# credentials, so a half-filled file fails loudly at `up` rather than starting
# an insecure stack.
#
# This file is committed; .env.production is NOT — check .gitignore before you
# put a real secret anywhere.

# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info

API_PORT=3000
GATEWAY_PORT=3001
HOST=0.0.0.0

# ─── Your domains ────────────────────────────────────────────────────────────
# Point all four at the VPS with A records before starting the stack — Caddy
# obtains certificates on first boot and will fail if DNS is not yet resolving.
WEB_DOMAIN=yappy.gg
# The web client (apps/webapp), served as a static SPA by Caddy.
APP_DOMAIN=app.yappy.gg
API_DOMAIN=api.yappy.gg
GATEWAY_DOMAIN=ws.yappy.gg
MEDIA_DOMAIN=cdn.yappy.gg
LIVEKIT_DOMAIN=rtc.yappy.gg
DOCS_DOMAIN=docs.yappy.gg

# Backup domain. The same six A records, pointed at the same VPS. Caddy serves
# every service on both, and the app fails over to these names on its own if the
# primary domain stops resolving. Leave every *_ALT blank to run a single
# domain, and delete the backup block from infra/Caddyfile if you do.
WEB_DOMAIN_ALT=tenku.xyz
APP_DOMAIN_ALT=app.tenku.xyz
API_DOMAIN_ALT=api.tenku.xyz
GATEWAY_DOMAIN_ALT=ws.tenku.xyz
MEDIA_DOMAIN_ALT=cdn.tenku.xyz
LIVEKIT_DOMAIN_ALT=rtc.tenku.xyz
DOCS_DOMAIN_ALT=docs.tenku.xyz

PUBLIC_API_URL=https://api.yappy.gg
PUBLIC_GATEWAY_URL=wss://ws.yappy.gg
PUBLIC_WEB_URL=https://yappy.gg
# Every origin the browser apps are served from. Both domains, both apex and
# www — and the web client's app.* origins, or it cannot call the API at all.
# http://yapp.localhost is the desktop app: the shell serves the bundled web
# client through its own yapp:// protocol (Windows WebView2 spells that origin
# http://yapp.localhost; macOS spells it yapp://localhost).
CORS_ORIGINS=https://yappy.gg,https://www.yappy.gg,https://app.yappy.gg,https://tenku.xyz,https://www.tenku.xyz,https://app.tenku.xyz,http://yapp.localhost,yapp://localhost

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=yappy
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_base64_32
POSTGRES_DB=yappy
# `postgres` is the service name on the internal compose network, not localhost.
DATABASE_URL=postgres://yappy:CHANGE_ME_openssl_rand_base64_32@postgres:5432/yappy
DATABASE_MAX_POOL=20

# ─── Auth ────────────────────────────────────────────────────────────────────
# Sign-in is email + password (Argon2id server-side). No SMS, no OTP — those
# variables are gone. Address verification and password reset send a six-digit
# code by email; see the mail block below, which they need to work at all.
#
# openssl rand -base64 48
# Rotating this invalidates every existing session, by design.
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48
JWT_ISSUER=yappy.gg
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=5184000

# ─── Email ───────────────────────────────────────────────────────────────────
# Verification and password-reset codes. Without this, an account whose
# password is forgotten cannot be recovered by anyone — the codes are the only
# way back in.
#
# `smtp` is an ordinary mailbox, which most domains already have. `resend` is
# an HTTP API, for anyone who would rather not keep a mailbox password here.
# `console` prints to the worker log and mails nobody: right for a staging box,
# wrong for anything people use.
#
# Hostinger mailboxes, which is what yappy.gg uses:
#   SMTP_HOST=smtp.hostinger.com
#   SMTP_PORT=465 with SMTP_SECURE=true   (or 587 with SMTP_SECURE=false)
#   SMTP_USER is the full mailbox address, SMTP_PASSWORD its password.
#
# EMAIL_FROM must be that same mailbox: providers refuse a From they did not
# authenticate. Hostinger also caps sending per hour — fine for codes, worth
# knowing before anything bulk goes through the same box.
#
# Check SPF and DKIM on the domain before the first real send. Hostinger sets
# both up for mailboxes it hosts; verify it rather than assume it, because the
# failure mode is codes landing in spam, which is worse than no feature.
EMAIL_PROVIDER=smtp
EMAIL_FROM=yappy <no-reply@yappy.gg>
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@yappy.gg
SMTP_PASSWORD=
# Only for EMAIL_PROVIDER=resend.
RESEND_API_KEY=
# ─── Object storage ──────────────────────────────────────────────────────────
# Self-hosted MinIO by default. To use Cloudflare R2 or S3 instead, drop the
# minio services from the compose file and point these at the provider — the
# code path is identical.
S3_ACCESS_KEY_ID=yappy
S3_SECRET_ACCESS_KEY=CHANGE_ME_openssl_rand_base64_32

# What the *services* use to reach the bucket, on the internal network.
S3_ENDPOINT=http://minio:9000
# What *clients* are sent to. SigV4 signs the Host header, so a presigned URL
# built against the internal name is invalid for a phone — this is why the two
# are separate, and getting it wrong produces uploads that fail only on device.
S3_PUBLIC_ENDPOINT=https://cdn.yappy.gg
S3_PUBLIC_BASE_URL=https://cdn.yappy.gg/yappy-public

S3_REGION=auto
S3_BUCKET_MEDIA=yappy-media
S3_BUCKET_PUBLIC=yappy-public
S3_FORCE_PATH_STYLE=true
MEDIA_MAX_UPLOAD_BYTES=104857600

# ─── Calling ─────────────────────────────────────────────────────────────────
LIVEKIT_URL=wss://rtc.yappy.gg
LIVEKIT_API_KEY=CHANGE_ME_any_identifier
LIVEKIT_API_SECRET=CHANGE_ME_openssl_rand_base64_32
CALL_RING_TIMEOUT_SECONDS=45
CALL_MAX_PARTICIPANTS=32

# ─── Push ────────────────────────────────────────────────────────────────────
# FCM service account JSON, as one line. The Android client also needs a
# matching google-services.json at build time.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# The .p8 from Certificates, Identifiers & Profiles → Keys, with the newlines
# written as \n so it survives being one line in an env file.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=gg.yappy.app
# Must be true for anything installed from TestFlight or the App Store.
#
# "Beta" is not a sandbox: Xcode rewrites `aps-environment` to `production` when
# it exports, so those builds register against Apple's production APNs. Left
# false — which is the code default, and why this line has to be here — the
# worker talks to the sandbox host, every push comes back `BadDeviceToken`, and
# nothing arrives on any device. Only a build run from Xcode onto a cable-
# attached phone uses the sandbox.
APNS_PRODUCTION=true

# ─── Optional ────────────────────────────────────────────────────────────────
GIF_PROVIDER=tenor
TENOR_API_KEY=
GIPHY_API_KEY=

# Signs the GitHub webhook that feeds the staff #gitlog channel. Generate with
# `openssl rand -hex 24` and paste the same value into the repository's
# Settings → Webhooks. Empty means POST /v1/webhooks/github refuses everything,
# which is the right state until the hook is actually configured — an
# unauthenticated route that can post a message must be off by default.
GITHUB_WEBHOOK_SECRET=
