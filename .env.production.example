# yappy.gg — production environment.
#
#   cp .env.production.example .env.production
#
# Then fill in every value marked CHANGE ME. The compose file uses `:?` on the
# credentials, so a half-filled file fails loudly at `up` rather than starting
# an insecure stack.
#
# This file is committed; .env.production is NOT — check .gitignore before you
# put a real secret anywhere.

# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info

API_PORT=3000
GATEWAY_PORT=3001
HOST=0.0.0.0

# ─── Your domains ────────────────────────────────────────────────────────────
# Point all four at the VPS with A records before starting the stack — Caddy
# obtains certificates on first boot and will fail if DNS is not yet resolving.
WEB_DOMAIN=yappy.gg
API_DOMAIN=api.yappy.gg
GATEWAY_DOMAIN=ws.yappy.gg
MEDIA_DOMAIN=cdn.yappy.gg
LIVEKIT_DOMAIN=rtc.yappy.gg

PUBLIC_API_URL=https://api.yappy.gg
PUBLIC_GATEWAY_URL=wss://ws.yappy.gg
PUBLIC_WEB_URL=https://yappy.gg
CORS_ORIGINS=https://yappy.gg,https://www.yappy.gg

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=yappy
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_base64_32
POSTGRES_DB=yappy
# `postgres` is the service name on the internal compose network, not localhost.
DATABASE_URL=postgres://yappy:CHANGE_ME_openssl_rand_base64_32@postgres:5432/yappy
DATABASE_MAX_POOL=20

# ─── Auth ────────────────────────────────────────────────────────────────────
# Sign-in is email + password (Argon2id server-side). No SMS, no OTP — those
# variables are gone, and nothing here sends email yet either: addresses are
# not verified and password reset does not exist. When reset is built it will
# need an email provider and SPF/DKIM on the sending domain.
#
# openssl rand -base64 48
# Rotating this invalidates every existing session, by design.
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48
JWT_ISSUER=yappy.gg
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=5184000

# ─── Object storage ──────────────────────────────────────────────────────────
# Self-hosted MinIO by default. To use Cloudflare R2 or S3 instead, drop the
# minio services from the compose file and point these at the provider — the
# code path is identical.
S3_ACCESS_KEY_ID=yappy
S3_SECRET_ACCESS_KEY=CHANGE_ME_openssl_rand_base64_32

# What the *services* use to reach the bucket, on the internal network.
S3_ENDPOINT=http://minio:9000
# What *clients* are sent to. SigV4 signs the Host header, so a presigned URL
# built against the internal name is invalid for a phone — this is why the two
# are separate, and getting it wrong produces uploads that fail only on device.
S3_PUBLIC_ENDPOINT=https://cdn.yappy.gg
S3_PUBLIC_BASE_URL=https://cdn.yappy.gg/yappy-public

S3_REGION=auto
S3_BUCKET_MEDIA=yappy-media
S3_BUCKET_PUBLIC=yappy-public
S3_FORCE_PATH_STYLE=true
MEDIA_MAX_UPLOAD_BYTES=104857600

# ─── Calling ─────────────────────────────────────────────────────────────────
LIVEKIT_URL=wss://rtc.yappy.gg
LIVEKIT_API_KEY=CHANGE_ME_any_identifier
LIVEKIT_API_SECRET=CHANGE_ME_openssl_rand_base64_32
CALL_RING_TIMEOUT_SECONDS=45
CALL_MAX_PARTICIPANTS=32

# ─── Push ────────────────────────────────────────────────────────────────────
# FCM service account JSON, as one line. The Android client also needs a
# matching google-services.json at build time.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=gg.yappy.app

# ─── Optional ────────────────────────────────────────────────────────────────
GIF_PROVIDER=tenor
TENOR_API_KEY=
GIPHY_API_KEY=
