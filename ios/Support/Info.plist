<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>yappy</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- Space Grotesk is the display face: the wordmark, headlines, titles and
	     buttons. Body text stays on the system sans, where reading speed beats
	     personality. Registered here so UIFont/Font can find it by PostScript
	     name at runtime. -->
	<key>UIAppFonts</key>
	<array>
		<string>SpaceGrotesk.ttf</string>
	</array>

	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>

	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!-- Portrait only, and there is no `~ipad` counterpart because there is no
	     iPad: `TARGETED_DEVICE_FAMILY` is 1. The variant that used to sit here
	     allowed all four orientations, which was a promise nothing in the app
	     could keep — the layout is built for a phone's width, and a landscape
	     13-inch iPad is one column stretched across 1366 points. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!-- `audio`: calls keep publishing while the app is backgrounded; without it
	     the mic is cut the moment the user switches apps mid-call.
	     `voip`: PushKit wakes a killed app for an incoming call so CallKit can
	     ring it — without this the phone only rings if the app happens to be
	     open, which is not a phone. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>voip</string>
	</array>

	<!--
	  These describe what the app actually does with the permission, which since
	  calling was gated off is no longer calling. A prompt that asks for the
	  microphone "for calls" in an app with no call button is the mismatch
	  Guideline 5.1.1 is about, and it is also just untrue to the person being
	  asked. Restore the call wording along with `Feature.calling`.
	-->
	<key>NSMicrophoneUsageDescription</key>
	<string>yappy needs your microphone to record voice notes and video notes you send in a chat.</string>
	<key>NSCameraUsageDescription</key>
	<string>yappy needs your camera to take photos and record video notes you send in a chat.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>yappy needs your photos so you can send them in a chat and set your picture.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>yappy uses Face ID to unlock the app when you turn on App Lock.</string>
	<!--
	  When In Use only, and asked for at the moment somebody taps Location.
	  Always-on would let a live share keep running with the app closed, which
	  is what WhatsApp does; it is also a permission people are right to refuse
	  and a review conversation to have deliberately rather than by accident.
	  A share here stops when the app does.
	-->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>yappy needs your location so you can share where you are in a chat, and keep it live while you are on your way.</string>

	<!-- Everything reaches the API over TLS. The one exception is a backend
	     running on the same machine during development: the simulator shares the
	     host's loopback, so localhost is reachable and is not on the public
	     internet. NSAllowsLocalNetworking scopes the exemption to exactly that
	     and to nothing else. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>gg.yappy.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>yappy</string>
			</array>
		</dict>
	</array>

	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
