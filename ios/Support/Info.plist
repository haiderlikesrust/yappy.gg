<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>yappy</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- Space Grotesk is the display face: the wordmark, headlines, titles and
	     buttons. Body text stays on the system sans, where reading speed beats
	     personality. Registered here so UIFont/Font can find it by PostScript
	     name at runtime. -->
	<key>UIAppFonts</key>
	<array>
		<string>SpaceGrotesk.ttf</string>
	</array>

	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>

	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- `audio`: calls keep publishing while the app is backgrounded; without it
	     the mic is cut the moment the user switches apps mid-call.
	     `voip`: PushKit wakes a killed app for an incoming call so CallKit can
	     ring it — without this the phone only rings if the app happens to be
	     open, which is not a phone. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>voip</string>
	</array>

	<key>NSMicrophoneUsageDescription</key>
	<string>yappy needs your microphone so you can talk in voice and video calls.</string>
	<key>NSCameraUsageDescription</key>
	<string>yappy needs your camera for video calls and for taking photos to send.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>yappy needs your photos so you can send them in a chat and set your picture.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>yappy uses Face ID to unlock the app when you turn on App Lock.</string>
	<!--
	  When In Use only, and asked for at the moment somebody taps Location.
	  Always-on would let a live share keep running with the app closed, which
	  is what WhatsApp does; it is also a permission people are right to refuse
	  and a review conversation to have deliberately rather than by accident.
	  A share here stops when the app does.
	-->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>yappy needs your location so you can share where you are in a chat, and keep it live while you are on your way.</string>

	<!-- Everything reaches the API over TLS. The one exception is a backend
	     running on the same machine during development: the simulator shares the
	     host's loopback, so localhost is reachable and is not on the public
	     internet. NSAllowsLocalNetworking scopes the exemption to exactly that
	     and to nothing else. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>gg.yappy.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>yappy</string>
			</array>
		</dict>
	</array>

	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
