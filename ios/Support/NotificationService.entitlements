<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The extension runs in its own sandbox. The group is how it reaches the
	     access token the app stored, which is what lets it load an avatar from
	     a private media URL. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.gg.yappy.app</string>
	</array>

	<!-- `UNNotificationContent.updating(from: intent)` is called here, in the
	     extension, so the entitlement has to be here too — carrying it only on
	     the app target throws at the call site. -->
	<key>com.apple.developer.usernotifications.communication</key>
	<true/>
</dict>
</plist>
