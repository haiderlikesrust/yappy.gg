{
  "name": "@yappy/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "envelope-check": "node scripts/envelope-check.mjs",
    "board-check": "node scripts/board-check.mjs",
    "ticket-check": "node scripts/ticket-channel-check.mjs",
    "bot-install-check": "tsx scripts/bot-install-check.mjs",
    "escalation-check": "tsx scripts/escalation-check.mjs",
    "channel-mention-check": "node scripts/channel-mention-check.mjs",
    "entity-guard-check": "node scripts/entity-guard-check.mjs",
    "new-channel-live-check": "node scripts/new-channel-live-check.mjs",
    "channel-burst-check": "node scripts/channel-burst-check.mjs",
    "category-check": "node scripts/category-check.mjs",
    "custom-emoji-check": "tsx --env-file-if-exists=../../.env scripts/custom-emoji-check.mjs",
    "mention-rollup-check": "node scripts/mention-rollup-check.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.717.0",
    "@aws-sdk/s3-request-presigner": "^3.717.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.1",
    "@node-rs/argon2": "^2.0.2",
    "@yappy/db": "workspace:*",
    "@yappy/shared": "workspace:*",
    "close-with-grace": "^2.1.0",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "jose": "^5.9.6",
    "livekit-server-sdk": "^2.9.2",
    "pg-boss": "^10.1.5",
    "pino": "^9.6.0",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2"
  }
}
