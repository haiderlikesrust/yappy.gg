# ─── Secrets ─────────────────────────────────────────────────────────────────
# Anything that has ever held a real credential. The `!` re-includes the
# templates, which are the only env files that belong in the repo.
.env
.env.*
!.env.example
!.env.production.example

# Firebase / Apple service credentials.
google-services.json
**/google-services.json
# The Android client reads the same four values from here instead of the JSON,
# so it can build with no Firebase project configured at all.
android/firebase.properties
*.p8
*-service-account*.json

# Android signing.
*.jks
*.keystore
android/keystore.properties
android/local.properties

# ─── Build output ────────────────────────────────────────────────────────────
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
.turbo/
.pnpm-store/

android/.gradle/
android/build/
android/app/build/
android/.kotlin/
android/.idea/
*.apk
*.aab

# Xcode per-user state: window positions, breakpoints, and the scheme Xcode
# generates for whoever opened the project. The *shared* scheme in
# xcshareddata is the one that belongs in the repo — without it
# `xcodebuild -scheme yappy` only works on the machine that created it.
xcuserdata/
*.xcuserstate
DerivedData/
*.xcarchive
*.ipa
# Package.resolved is deliberately NOT ignored: it pins the LiveKit and WebRTC
# versions, and an app that resolves them differently per machine is an app
# whose call stack differs per build.

# ─── Local state ─────────────────────────────────────────────────────────────
# Container volumes and downloaded binaries (MinIO, LiveKit) — regenerated, and
# .volumes contains the actual database.
.volumes/
.tools/

*.log
.DS_Store
Thumbs.db

# ─── Editors ─────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp

# Desktop (Tauri) build artifacts.
desktop/src-tauri/target
desktop/src-tauri/gen
