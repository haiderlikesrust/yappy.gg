{
  "name": "yappy",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" build && pnpm -r --filter \"./apps/**\" build",
    "dev": "pnpm --parallel --filter \"./apps/**\" dev",
    "dev:api": "pnpm --filter @yappy/api dev",
    "dev:gateway": "pnpm --filter @yappy/gateway dev",
    "dev:worker": "pnpm --filter @yappy/worker dev",
    "db:generate": "pnpm --filter @yappy/db generate",
    "db:migrate": "pnpm --filter @yappy/db migrate",
    "db:studio": "pnpm --filter @yappy/db studio",
    "db:seed": "pnpm --filter @yappy/db seed",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "typecheck": "pnpm -r typecheck",
    "smoke": "pnpm --filter @yappy/gateway smoke",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
