{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yappy",
  "version": "1.0.0",
  "identifier": "gg.yappy.desktop",
  "build": {
    "frontendDist": "https://app.yappy.gg"
  },
  "app": {
    "windows": [
      {
        "title": "yappy",
        "url": "https://app.yappy.gg",
        "width": 1240,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#1b1926"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
