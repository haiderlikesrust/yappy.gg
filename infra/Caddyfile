# yappy reverse proxy.
#
# Caddy is here for one reason above all others: it obtains and renews TLS
# certificates by itself. On a single VPS that removes the entire certbot
# apparatus, and a chat app cannot ship without HTTPS: the Android client
# refuses cleartext, and WebSocket upgrades over plain HTTP are blocked by
# every modern network in between.
#
# Five services, each with genuinely different needs:
#   web      the marketing page and the developer portal, both static from disk
#   api      ordinary HTTP, small body cap, health-checked upstream
#   gateway  long-lived WebSockets, ten-minute idle timeouts
#   media    large bodies, cacheable responses, proxied to MinIO
#   livekit  signalling only (media goes direct over UDP, see the compose file)
#
# Each service is a snippet, imported into a site block per hostname. That is
# what lets the same five services answer on a whole second domain (the backup)
# without duplicating their config: define once, import twice.

# ── Service definitions ───────────────────────────────────────────────────────

(websvc) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	# Hashed asset names would let this be immutable; these are not, so a short
	# TTL is the honest setting.
	header /*.png Cache-Control "public, max-age=3600"
	# iOS refuses an association file that is not served as application/json,
	# and this one has no extension for Caddy to infer a type from — with
	# nosniff set above it would arrive as octet-stream and universal links
	# would silently never verify.
	header /.well-known/apple-app-site-association Content-Type "application/json"
	root * /srv/web

	# Invite links are the one page here that is not a file.
	#
	# /join/<code> is rendered by the API so that a pasted link unfurls as the
	# group it is for: link previewers do not run JavaScript, and the static
	# page fetched everything it displayed — so every invite ever shared arrived
	# anonymous, whichever group it was for. See apps/api/src/routes/join.ts,
	# which serves this same file from web/ with the tags filled in.
	#
	# `handle` blocks rather than a matcher plus bare directives: handles are
	# mutually exclusive and evaluated in written order, so the proxy and the
	# file server cannot both claim a request.
	handle /join/* {
		reverse_proxy api:3000
	}

	# Bare /join carries no code and is nobody's invite.
	redir /join /

	handle {
		try_files {path} {path}/index.html
		file_server
	}
}

(docssvc) {
	# The generated developer docs. Same files the main site serves at /docs/,
	# given their own document root so that docs.yappy.gg/bots/ works as well as
	# yappy.gg/docs/bots/. The pages link relatively, which is what lets one
	# build answer on both.
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	header /*.png Cache-Control "public, max-age=3600"
	root * /srv/web/docs
	try_files {path} {path}/index.html
	file_server
}

(apisvc) {
	encode zstd gzip
	# Uploads never come through here (the client PUTs to the object store
	# directly), so a small body limit is a real defence rather than a nuisance.
	request_body {
		max_size 2MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy api:3000 {
		health_uri /ready
		health_interval 15s
	}
}

(wssvc) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	# A chat socket is idle for minutes at a time between messages, and the
	# app's own heartbeat is ~41s. Anything shorter here would sever healthy
	# connections and produce a reconnect storm.
	reverse_proxy gateway:3001 {
		transport http {
			read_timeout 10m
			write_timeout 10m
		}
	}
}

(mediasvc) {
	encode zstd gzip
	# Avatars, banners, emoji and stickers are immutable: the object key contains
	# a random component, so a changed picture is a changed URL and this can be
	# cached hard.
	header /yappy-public/* Cache-Control "public, max-age=31536000, immutable"
	header {
		X-Content-Type-Options "nosniff"
		-Server
	}
	reverse_proxy minio:9000
}

(rtcsvc) {
	header -Server
	# Signalling and the TURN/TCP fallback. The UDP media path bypasses Caddy
	# entirely and is published straight from the container.
	reverse_proxy livekit:7880 {
		transport http {
			read_timeout 10m
			write_timeout 10m
		}
	}
}

# ── Primary domain ────────────────────────────────────────────────────────────

{$WEB_DOMAIN} {
	import websvc
}
www.{$WEB_DOMAIN} {
	redir https://{$WEB_DOMAIN}{uri} permanent
}
{$DOCS_DOMAIN} {
	import docssvc
}
{$API_DOMAIN} {
	import apisvc
}
{$GATEWAY_DOMAIN} {
	import wssvc
}
{$MEDIA_DOMAIN} {
	import mediasvc
}
{$LIVEKIT_DOMAIN} {
	import rtcsvc
}

# ── Backup domain ─────────────────────────────────────────────────────────────
#
# The same five services on a second, independent domain, so the app keeps
# working if the primary domain has a registry or DNS problem. The client
# fails over to these names on its own (see ApiClient.kt).
#
# Remove this whole section if you do not want a backup domain, and leave the
# *_DOMAIN_ALT variables unset. Caddy obtains certificates for every name it is
# given, so an ALT name that does not resolve to this box will retry noisily
# until it does.

{$WEB_DOMAIN_ALT} {
	import websvc
}
www.{$WEB_DOMAIN_ALT} {
	redir https://{$WEB_DOMAIN_ALT}{uri} permanent
}
{$DOCS_DOMAIN_ALT} {
	import docssvc
}
{$API_DOMAIN_ALT} {
	import apisvc
}
{$GATEWAY_DOMAIN_ALT} {
	import wssvc
}
{$MEDIA_DOMAIN_ALT} {
	import mediasvc
}
{$LIVEKIT_DOMAIN_ALT} {
	import rtcsvc
}
