# The bot token, shown once when you create the bot. Required.
YAPPY_TOKEN=yb_...

# Point these at a local stack while developing. Both default to production.
# YAPPY_API_URL=http://localhost:3000/v1
# YAPPY_GATEWAY_URL=ws://localhost:3001

# Where reminders are kept between restarts.
# UTILITY_DATA=./data/state.json

# The zone this bot thinks in when nobody says otherwise: "9pm" means 9pm here.
# Any IANA name.
# UTILITY_TZ=UTC
