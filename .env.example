# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

API_PORT=3000
GATEWAY_PORT=3001

# Public origins, used for CORS, invite links and deep links.
PUBLIC_API_URL=http://localhost:3000
PUBLIC_GATEWAY_URL=ws://localhost:3001
PUBLIC_WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,http://localhost

# ─── Database ────────────────────────────────────────────────────────────────
# These three are also read by docker-compose.yml, so the container and the
# connection string below cannot drift apart.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=yappy_dev
POSTGRES_DB=yappy
DATABASE_URL=postgres://postgres:yappy_dev@localhost:5432/yappy
# Separate pool for LISTEN/NOTIFY sessions (they hold a connection open).
DATABASE_MAX_POOL=20

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=dev_only_change_me_dev_only_change_me_dev_only
JWT_ISSUER=yappy.gg
ACCESS_TOKEN_TTL=900          # seconds (15 min)
REFRESH_TOKEN_TTL=5184000     # seconds (60 days)
OTP_TTL=300                   # seconds (5 min)
OTP_MAX_ATTEMPTS=5

# Sign in with Apple / Google (required for App Store review if you offer social login)
APPLE_CLIENT_ID=gg.yappy.app
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
GOOGLE_CLIENT_IDS=

# ─── Object storage (S3 / R2 / MinIO) ────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=yappy
S3_SECRET_ACCESS_KEY=yappy_dev_secret
S3_BUCKET_MEDIA=yappy-media
S3_BUCKET_PUBLIC=yappy-public
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000/yappy-public
MEDIA_MAX_UPLOAD_BYTES=104857600   # 100 MB

# ─── Calling (LiveKit) ───────────────────────────────────────────────────────
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_change_me_in_production
CALL_RING_TIMEOUT_SECONDS=45
CALL_MAX_PARTICIPANTS=32

# ─── GIF provider ────────────────────────────────────────────────────────────
# Tenor v2 is the default (better rate limits and licensing than Giphy for apps).
GIF_PROVIDER=tenor
TENOR_API_KEY=
GIPHY_API_KEY=

# ─── Push notifications ──────────────────────────────────────────────────────
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=gg.yappy.app
APNS_PRODUCTION=false

FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ─── Outbound (OTP delivery) ─────────────────────────────────────────────────
SMS_PROVIDER=console          # console | twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# console prints the letter to the worker log, which is the inbox in dev.
EMAIL_PROVIDER=console        # console | smtp | resend
EMAIL_FROM=yappy <hello@yappy.gg>
# For EMAIL_PROVIDER=smtp. 465 with SMTP_SECURE=true, or 587 with false.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Where a suspended account can argue with the suspension. Empty turns the
# notice off rather than sending somebody a dead end.
SUPPORT_EMAIL=
# Send that notice *from* support@ as well, where the provider allows a From
# it did not authenticate. Most mailbox hosts do not — leave empty and the
# notice goes out from the usual sender with Reply-To pointing at support.
SUPPORT_FROM=

# For EMAIL_PROVIDER=resend.
RESEND_API_KEY=

# Set when clients reach the bucket by a different name than this server does
# (emulator, LAN device, or an internal vs public endpoint in production).
# S3_PUBLIC_ENDPOINT=http://10.0.2.2:9000
