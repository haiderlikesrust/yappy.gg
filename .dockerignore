# Everything that must not reach the build context — for speed, for image size,
# and in the case of .env, because a secret baked into a layer stays there even
# if a later layer deletes it.
.env
.env.*
!.env.example

node_modules
**/node_modules
dist
**/dist
*.tsbuildinfo
**/*.tsbuildinfo

# Local state and downloaded binaries.
.volumes
.tools

# The Android client is not part of the backend image.
android

.git
.github
docs
# The site is served by Caddy from a bind mount, not baked into the image —
# except the icon, which the avatar-seeding script reads at runtime.
web/*
!web/icon.png
*.log
.DS_Store
